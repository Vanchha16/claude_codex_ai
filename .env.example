# Copy to .env (git-ignored) and fill in. Never paste these values into prompts, reports or chats.

# Precedence: built-in defaults < .venv/.env < .env < config/local_settings.json (dashboard Setup) < process environment.
# Only the keys listed here (and the aliases TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, GOLD_TELEGRAM_CHAT_ID) are read.

# Data source: "mt5" only (your running, logged-in MT5 terminal; read-only). Leave empty for the default.
GOLD_DATA_MODE=

# Exact broker symbol as shown in your MT5 terminal (e.g. list candidates with: gold.cmd symbols).
# It is never guessed: XAUUSD vs XAUUSDm etc. are different contracts.
GOLD_SYMBOL=

# Optional: full path to terminal64.exe if MT5 cannot find your running terminal automatically.
GOLD_MT5_TERMINAL_PATH=
# LEGACY, normally leave unset: the MetaTrader5 Python API already returns UTC epochs.
# A nonzero value shifts every MT5 time and is reported in the dashboard status.
GOLD_MT5_SERVER_UTC_OFFSET_HOURS=

# Display only (strategy computation is always UTC): UTC, local, or an IANA zone such as Asia/Bangkok.
GOLD_DISPLAY_TIMEZONE=

# Telegram (see README > Telegram setup). TELEGRAM_BOT_TOKEN in .venv/.env is accepted as an alias for the token.
# The destination is the numeric chat ID (e.g. -100...), not the bot username. It can also be entered in the dashboard.
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_TEST_CHAT_ID=

# Dashboard / scanner
GOLD_PORT=8000
GOLD_SCAN_INTERVAL_SECONDS=5

# Replay assumptions for OHLC-only history (price units)
GOLD_REPLAY_SPREAD=0.20
GOLD_REPLAY_SLIPPAGE=0.05
