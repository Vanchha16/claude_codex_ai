{
  "name": "gold-signals-dashboard-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Project-local build of the TailAdmin-based dashboard assets served by the FastAPI app (app/static/dist).",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o ../app/static/dist/app.css --minify",
    "build:assets": "node copy-assets.mjs",
    "build": "npm run build:css && npm run build:assets",
    "test": "node --test tests/timefmt.test.mjs tests/nav.test.mjs tests/zones.test.mjs tests/fvg-display.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/outfit": "5.2.8",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.10",
    "alpinejs": "3.17.2",
    "lightweight-charts": "5.2.1",
    "tailwindcss": "4.3.3"
  }
}
